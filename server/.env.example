# SQLite by default. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agent_social
DATABASE_URL=sqlite:///./agent_social.db

SECRET_KEY=replace-this-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173

# Provider values: mock, openai, ollama
LLM_PROVIDER=mock

# OpenAI-compatible endpoint configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Ollama OpenAI-compatible endpoint alternative:
# LLM_PROVIDER=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.2
# OPENAI_API_KEY=ollama

# Optional. If configured, approval + publish sends a real signed HTTP POST.
PUBLISH_WEBHOOK_URL=
PUBLISH_WEBHOOK_SECRET=replace-with-a-webhook-signing-secret